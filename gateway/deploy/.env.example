# Copy to .env. The only required value is the key.
#
# Everything here is documented by `dsgate --help` and reasoned about in
# ../DESIGN.md. The two that actually bound the spend are the budgets;
# the rest is fairness between users.

# The real DeepSeek key this service spends. Never leaves the process.
DSGATE_UPSTREAM_KEY=sk-

# Public URL, shown to clients so they can see where their prompts go.
DSGATE_ANNOUNCE=https://free.example.com

# Browser origins allowed to call the mint and the proxy. The playground
# is the only intended caller; leave empty to disable CORS entirely.
DSGATE_ORIGINS=https://thevibeworks.github.io

# Enables GET /admin/health. Leave empty to disable the endpoint.
DSGATE_ADMIN_TOKEN=

# Required behind a reverse proxy, dangerous without one: it makes
# X-Forwarded-For authoritative for identity and rate limiting.
DSGATE_TRUST_PROXY=1

# The circuit breaker and the credit pool. These are the numbers that
# protect you; per-user quota does not.
DSGATE_DAILY_BUDGET_USD=1.00
DSGATE_TOTAL_BUDGET_USD=20.00

# Per user, per UTC day.
DSGATE_ANON_DAILY_REQUESTS=30
DSGATE_ANON_DAILY_INPUT_TOKENS=60000
DSGATE_ANON_DAILY_OUTPUT_TOKENS=20000

# Anti-abuse. Each +1 bit doubles what it costs to mint an identity;
# beyond MINT_DAILY_PER_IP the difficulty escalates per address anyway.
DSGATE_POW_BITS=20
DSGATE_MINT_DAILY_PER_IP=3

# Host-side.
DSGATE_PORT=8787
DSGATE_IMAGE=ghcr.io/thevibeworks/dsgate:latest
DSGATE_MEM_LIMIT=192m
